@page "/hfe-model"
@rendermode InteractiveServer
@using OutputStageSimulator.Core
@using OutputStageSimulator.Web.State
@inject IJSRuntime JS
@inject SimulationState State
@inject NavigationManager Nav

<PageTitle>hFE Model - Output Stage Analysis</PageTitle>

<div class="hero-mini">
    <button type="button" class="back-link" @onclick="GoHome">← Back</button>
    <h1>hFE vs Ic — @TransistorProfiles.All[State.SelectedTransistorIndex].Name</h1>
</div>

<div class="card chart-card-full">
    <div class="chart-wrap-full">
        <canvas id="hfeChartFull"></canvas>
    </div>
</div>

<div class="card">
    <fieldset class="accent-hfe">
        <legend>Transistor hfe model</legend>
        <label>
            Hfe curve model
            <select @bind="State.HfeCurveKind" @bind:after="OnFieldChanged">
                <option value="@HfeCurveKind.Piecewise">Piecewise (original, has a kink)</option>
                <option value="@HfeCurveKind.SmoothBlend">Smooth blend (no kink)</option>
            </select>
        </label>
        <label>Hfe max <input type="number" step="any" @bind="State.Hfemax" @bind:after="OnFieldChanged" /></label>
        <label>I at Hfe max, Imax (A) <input type="number" step="any" @bind="State.Imax" @bind:after="OnFieldChanged" /></label>
        <label>a-factor <input type="number" step="any" @bind="State.AFactor" @bind:after="OnFieldChanged" /></label>
        <label>dI derating (1/A) <input type="number" step="any" @bind="State.DI" @bind:after="OnFieldChanged" /></label>
        <label>Iturnover (A) <input type="number" step="any" @bind="State.Iturnover" @bind:after="OnFieldChanged" /></label>
    </fieldset>

    <div class="button-row">
        <button class="save-button" @onclick="Save">💾 Save to JSON</button>
        @if (_savedMessage is not null)
        {
            <span class="saved-message">@_savedMessage</span>
        }
    </div>
    <p class="hint">
        Saves the current Hfe max / Imax / a-factor / dI / Iturnover values for
        <strong>@TransistorProfiles.All[State.SelectedTransistorIndex].Name</strong> to
        <code>Data/transistor-hfe-models.json</code> (in the app's output directory), so they're
        remembered next time this transistor type is selected — including across restarts, since
        the file is written to disk. This does not change the thesis presets on the main page;
        those stay exact for reproducing the thesis's own figures.
    </p>
</div>

@code {
    private bool _needsChartUpdate = true;
    private string? _savedMessage;

    private void OnFieldChanged()
    {
        State.OnFieldChanged();
        _needsChartUpdate = true;
        _savedMessage = null;
    }

    private void Save()
    {
        State.SaveCurrentHfeParameters();
        _savedMessage = "Saved.";
    }

    private void GoHome() => Nav.NavigateTo("/");

    private static IEnumerable<double> LogSpace(double from, double to, int count)
    {
        var logFrom = Math.Log10(from);
        var logTo = Math.Log10(to);
        for (var i = 0; i < count; i++)
        {
            var t = i / (double)(count - 1);
            yield return Math.Pow(10, logFrom + t * (logTo - logFrom));
        }
    }

    private sealed record XyPoint(double X, double Y);

    /// <summary>
    /// Log-spaced background points across the full range, plus a denser
    /// linearly-spaced cluster around Iturnover — otherwise the transition
    /// region (where the curve actually bends) only gets a handful of the
    /// log-spaced points, and Chart.js's spline interpolation can make an
    /// honestly-smooth curve look kinked when sampled that sparsely.
    /// </summary>
    private static IEnumerable<double> HfeSamplePoints(double from, double to, int backgroundCount, double iturnover, int denseCount = 60)
    {
        var points = LogSpace(from, to, backgroundCount).ToList();

        var lo = Math.Max(from, iturnover * 0.4);
        var hi = Math.Min(to, iturnover * 2.5);
        for (var k = 0; k < denseCount; k++)
        {
            var t = k / (double)(denseCount - 1);
            points.Add(lo + t * (hi - lo));
        }

        return points.Distinct().OrderBy(x => x);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || !_needsChartUpdate)
        {
            return;
        }

        _needsChartUpdate = false;

        var profile = TransistorProfiles.All[State.SelectedTransistorIndex];
        var referenceCurve = profile.ReferenceHfeCurve
            .Select(p => new XyPoint(p.Ic, p.Hfe))
            .ToArray();

        var hfeModel = State.CreateHfeModel();
        var calculatedCurve = HfeSamplePoints(0.01, 10, 80, State.Iturnover)
            .Select(ic => new XyPoint(ic, Math.Max(0, hfeModel.Hfe(ic))))
            .ToArray();

        await JS.InvokeVoidAsync(
            "hfeChart.render",
            "hfeChartFull",
            referenceCurve,
            calculatedCurve,
            $"{profile.Name} (datasheet)",
            "Calculated (this simulation)",
            false);
    }
}
